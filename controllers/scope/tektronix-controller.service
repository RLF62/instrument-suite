[Unit]
Description=Fischer Lab Tektronix Ethernet Controller
After=network.target
[Service]
WorkingDirectory=%h/tektronix-controller
ExecStart=%h/tektronix-controller-venv/bin/gunicorn --workers 1 --threads 4 --timeout 90 --bind 0.0.0.0:8081 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
[Install]
WantedBy=default.target
